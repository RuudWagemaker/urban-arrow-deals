# Goes in /etc/caddy-sites/deals.caddy on the server.
deals.128-140-101-183.sslip.io {
	encode gzip
	# Optional password (make the hash with:
	#   docker exec deploy-caddy-1 caddy hash-password --plaintext 'your-password')
	# basic_auth {
